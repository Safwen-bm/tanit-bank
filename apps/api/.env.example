# Neon: POOLED connection string (host contains -pooler). Used by the running API.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: DIRECT connection string. Used by prisma migrate and the seed scripts.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

CORS_ORIGIN="http://localhost:3000"
PORT=4000

# Leave unset locally. On Render, behind the Vercel proxy, set it to 2.
# TRUST_PROXY_HOPS=2

# First admin, read only by `npm run db:seed`
ADMIN_EMAIL="@"
ADMIN_PASSWORD="pick-a-strong-password-10+"
ADMIN_NAME="Bank Administrator"